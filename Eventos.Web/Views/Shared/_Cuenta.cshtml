@model DateTime
@{
    var horas = (Model - DateTime.Now).TotalHours;
}
<span class="cuenta @(horas >= 0 && horas < 24 ? "cuenta--urgente" : "") @(horas < -3 ? "cuenta--fin" : "")" data-inicio="@Model.ToString("yyyy-MM-ddTHH:mm:ss")">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.2"/><path d="M8 4.6V8l2.2 1.4"/></svg>
    <span class="cuenta__texto">@Estilo.Faltan(Model)</span>
</span>
