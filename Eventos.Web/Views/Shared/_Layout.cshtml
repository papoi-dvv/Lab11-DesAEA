@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    string Activo(string nombre) => controlador == nombre ? "activo" : "";
    var deshacerUrl = TempData["DeshacerUrl"] as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] · Eventos</title>
    <script>
        // Se aplica antes de pintar para evitar el parpadeo al cargar en modo oscuro.
        (function () {
            try {
                var t = localStorage.getItem('tema');
                if (!t) { t = matchMedia('(prefers-color-scheme: dark)').matches ? 'oscuro' : 'claro'; }
                document.documentElement.dataset.tema = t;
            } catch (e) { }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/componentes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vistas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/interfaz.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
</head>
<body>
    <div class="progreso" id="progreso" aria-hidden="true"></div>

    <header class="topbar">
        <div class="contenedor topbar__fila">
            <a class="marca" asp-controller="Eventos" asp-action="Index">
                <span class="marca__punto"></span>eventos
            </a>

            <nav class="segmento" id="segmento" aria-label="Principal">
                <span class="segmento__pastilla" id="pastilla"></span>
                <a class="segmento__op @Activo("Eventos")" asp-controller="Eventos" asp-action="Index">Eventos</a>
                <a class="segmento__op @Activo("Asistentes")" asp-controller="Asistentes" asp-action="Index">Asistentes</a>
                <a class="segmento__op @Activo("Inscripciones")" asp-controller="Inscripciones" asp-action="Index">Inscripciones</a>
                <a class="segmento__op @Activo("Categorias")" asp-controller="Categorias" asp-action="Index">Categorías</a>
            </nav>

            <button type="button" class="tema-btn" id="temaBtn" aria-label="Cambiar entre modo claro y oscuro" title="Modo claro / oscuro">
                <svg class="tema-btn__sol" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                <svg class="tema-btn__luna" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
            </button>
        </div>
    </header>

    <main class="contenedor principal">
        @RenderBody()
    </main>

    <footer class="pie contenedor">Eventos · Semana 11 · EF Core Code First</footer>

    <div class="toasts" id="toasts" aria-live="polite">
        @if (TempData["Exito"] is string exito)
        {
            <div class="toast toast--exito" role="status">
                <span class="toast__icono"><svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.2 3.2L13 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span class="toast__texto">@exito</span>
                @if (!string.IsNullOrEmpty(deshacerUrl))
                {
                    <form method="post" action="@deshacerUrl" class="toast__form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="toast__accion">Deshacer</button>
                    </form>
                }
                <button type="button" class="toast__cerrar" aria-label="Cerrar">×</button>
                <span class="toast__tiempo"></span>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="toast toast--error" role="alert">
                <span class="toast__icono"><svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M8 4.5v4M8 11.2v.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
                <span class="toast__texto">@error</span>
                <button type="button" class="toast__cerrar" aria-label="Cerrar">×</button>
                <span class="toast__tiempo"></span>
            </div>
        }
    </div>

    <div class="modal" id="modal" hidden>
        <div class="modal__fondo" data-cerrar></div>
        <div class="modal__caja" role="alertdialog" aria-modal="true" aria-labelledby="modalTitulo" aria-describedby="modalTexto">
            <div class="modal__icono" id="modalIcono">!</div>
            <h2 id="modalTitulo"></h2>
            <p id="modalTexto"></p>
            <div class="modal__acciones">
                <button type="button" class="btn btn--enlace" data-cerrar>Cancelar</button>
                <button type="button" class="btn btn--peligro" id="modalOk">Confirmar</button>
            </div>
        </div>
    </div>

    <aside class="drawer" id="drawer" hidden aria-hidden="true">
        <div class="drawer__fondo" data-cerrar></div>
        <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="drawerTitulo">
            <header class="drawer__cabecera">
                <div>
                    <small>Inscripción rápida</small>
                    <h2 id="drawerTitulo"></h2>
                    <p class="meta" id="drawerMeta"></p>
                </div>
                <button type="button" class="drawer__x" data-cerrar aria-label="Cerrar">×</button>
            </header>
            <div class="drawer__buscar">
                <input type="search" id="drawerBuscar" placeholder="Buscar asistente por nombre o DNI…" autocomplete="off" />
            </div>
            <div class="drawer__lista" id="drawerLista" role="listbox" aria-label="Asistentes"></div>
            <footer class="drawer__pie">
                <p class="drawer__aviso" id="drawerAviso" role="status"></p>
                <div class="drawer__acciones">
                    <a class="btn btn--enlace" asp-controller="Asistentes" asp-action="Create">Nuevo asistente</a>
                    <button type="button" class="btn btn--primario" id="drawerOk" disabled>Confirmar inscripción</button>
                </div>
            </footer>
        </div>
    </aside>

    <form id="af" hidden>@Html.AntiForgeryToken()</form>

    <script src="~/js/dropdown.js" asp-append-version="true"></script>
    <script src="~/js/fecha.js" asp-append-version="true"></script>
    <script src="~/js/efectos.js" asp-append-version="true"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
    <script src="~/js/inscripcion.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
