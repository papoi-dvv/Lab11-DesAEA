@model Evento

<div asp-validation-summary="ModelOnly"></div>

<div class="campo">
    <label asp-for="Titulo"></label>
    <input asp-for="Titulo" placeholder="Ej. Cloud Day Lima" />
    <span asp-validation-for="Titulo" class="text-danger"></span>
</div>

<div class="fila2">
    <div class="campo">
        <label asp-for="Fecha"></label>
        <input asp-for="Fecha" data-datetime />
        <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>
    <div class="campo">
        <label asp-for="Lugar"></label>
        <input asp-for="Lugar" placeholder="Dirección o enlace" />
        <span asp-validation-for="Lugar" class="text-danger"></span>
    </div>
</div>

<div class="fila2">
    <div class="campo">
        <label asp-for="CategoriaId"></label>
        <select asp-for="CategoriaId" asp-items="(SelectList)ViewBag.Categorias" data-dropdown>
            <option value="">Selecciona una categoría</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>
    <div class="campo">
        <label asp-for="Modalidad"></label>
        <select asp-for="Modalidad" asp-items="(SelectList)ViewBag.Modalidades" data-dropdown></select>
        <span asp-validation-for="Modalidad" class="text-danger"></span>
    </div>
</div>

<div class="fila2">
    <div class="campo">
        <label asp-for="Aforo"></label>
        <input asp-for="Aforo" type="number" min="1" max="5000" />
        <span asp-validation-for="Aforo" class="text-danger"></span>
    </div>
    <div class="campo">
        <label asp-for="Precio"></label>
        <input asp-for="Precio" type="number" step="0.01" min="0" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
</div>
